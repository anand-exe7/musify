# ─────────────────────────────────────────────────────────────────────────
# Neon (serverless Postgres) connection string.
#
# 1. Create a project at https://neon.tech and copy the connection string
#    (Dashboard → Connection Details → "Connection string").
# 2. Copy this file to `.env.local` and paste your string below.
# 3. Run the migrations and seed:
#        npm run db:migrate
#        npm run db:seed
#
# Use the POOLED connection string (it contains `-pooler`) for the app.
# It must include `?sslmode=require`.
# ─────────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require"

# ─────────────────────────────────────────────────────────────────────────
# App URL — the public origin of the app. Used to build the Google OAuth
# redirect URI (<APP_URL>/api/auth/callback/google). Set to your deployed URL
# in production (e.g. https://shop.example.com).
# ─────────────────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────────────────
# Auth (Google OAuth + signed session cookie). See AUTH.md for full setup.
#
# AUTH_SECRET  — signs the session cookie. Generate one with:
#                    openssl rand -base64 32
# GOOGLE_*     — from https://console.cloud.google.com/apis/credentials
#                Create an "OAuth client ID" (Web application) and add this as
#                an "Authorized redirect URI":
#                    <APP_URL>/api/auth/callback/google
#
# Admin access is NOT set via env — it lives in the database `users.is_admin`
# column. Grant it with:  npm run admin:set -- someone@gmail.com
# ─────────────────────────────────────────────────────────────────────────
AUTH_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─────────────────────────────────────────────────────────────────────────
# Razorpay (client-facing storefront checkout only — not admin billing).
# Keys from https://dashboard.razorpay.com → Settings → API Keys. Use the
# TEST keys (rzp_test_…) while developing. NEXT_PUBLIC_RAZORPAY_KEY_ID is the
# same key id, exposed to the browser checkout (safe — it's publishable).
# ─────────────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ─────────────────────────────────────────────────────────────────────────
# Resend (customer order-confirmation emails only). API key from
# https://resend.com/api-keys. ORDER_FROM_EMAIL must be a verified sender/
# domain in production; Resend's onboarding@resend.dev works for testing.
# ─────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=""
ORDER_FROM_EMAIL="Sri Saraswathy Musicals <onboarding@resend.dev>"
