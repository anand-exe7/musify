# ─────────────────────────────────────────────────────────────────────────
# Neon (serverless Postgres) connection string.
#
# 1. Create a project at https://neon.tech and copy the connection string
#    (Dashboard → Connection Details → "Connection string").
# 2. Copy this file to `.env.local` and paste your string below.
# 3. Run the migrations and seed:
#        npm run db:migrate
#        npm run db:seed
#
# Use the POOLED connection string (it contains `-pooler`) for the app.
# It must include `?sslmode=require`.
# ─────────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require"
